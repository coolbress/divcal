# 설정은 환경으로 외부화한다 (12-Factor III). 코드에 하드코딩하지 않는다.
#
# 이 파일은 **키만** 담는다 — 실제 값은 .env 에 넣고, .env 는 커밋되지 않는다.
# 새로 참여하는 사람이 무엇을 채워야 하는지 아는 유일한 통로다.
#
# 이건 관례가 아니라 검사다: tests/test_env_example.py 가
# 소스가 읽는 os.environ / os.getenv 키를 전부 여기서 찾는다.
# 없으면 테스트가 실패한다 — 파일이 있다는 것만으로는 부족하기 때문이다.

# 로그 형식. 안 주면 stdout 이 터미널이면 text, 아니면 json 이다.
# 🔴 `docker run -t` 는 프로덕션에도 TTY 를 붙이므로, 수집기로 보낼 땐 여기서 못 박아라.
# LOG_FORMAT=json

# 예정표 CSV 의 경로. `divcal serve <경로>` 로 주면 인자가 이긴다.
# 🔴 컨테이너로 띄우면 CMD 에 인자를 못 박는다 — 그때 이 키가 유일한 통로다.
# DIVCAL_SCHEDULE=/data/schedule.csv

# 들을 포트. 안 주면 8765.
# DIVCAL_PORT=8765

# 원천징수 세율(퍼센트). 안 주면 세전으로 찍는다.
# DIVCAL_TAX=15
